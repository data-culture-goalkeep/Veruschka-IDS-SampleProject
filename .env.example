# Place real secrets in the execution environment's Secret settings, never Git/chat.
# The loader must compare this variable to its hardcoded allowed project.
SUPABASE_PROJECT_REF=<allowed-project-ref>
SUPABASE_ACCESS_TOKEN=<configure-in-environment-secret-settings>
SOURCE_SPREADSHEET_ID=<approved-source-spreadsheet-id>
SOURCE_TIMEZONE=Asia/Kolkata
# No remote connection string is needed for the local validator or dummy seed.
